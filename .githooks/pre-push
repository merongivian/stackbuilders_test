#!/usr/bin/env bash
# Hard gate: nothing gets pushed unless the full suite is green.
set -euo pipefail

red() { printf '\n\033[31m✗ %s\033[0m\n\n' "$*" >&2; }

printf '\033[2m▶ RuboCop\033[0m\n'
if ! bundle exec rubocop; then
  red "RuboCop failed. Push blocked."
  exit 1
fi

printf '\033[2m▶ RSpec\033[0m\n'
if ! bundle exec rspec; then
  red "RSpec failed. Push blocked."
  exit 1
fi

exit 0
